# Hostess (Steward) — Production: Railway + Vercel + Supabase (not hosted locally)
# Frontend runs on Vercel; backend on Railway; DB/auth/storage via Supabase.
# Copy to .env.local for local dev. Set in Vercel Dashboard for Production/Preview.

# Backend (Railway) — use your Railway service URL. Variable names are required by code.
VITE_API_BASE_PATH=https://<railway-prod>/api
VITE_WS_BASE_URL=wss://<railway-prod>/ws
# VITE_API_URL is not used; use VITE_API_BASE_PATH.

# MCP (optional) — same origin or /api/mcp when used
VITE_MCP_API_BASE_PATH=

# Supabase (public client key only; never secret/service_role) — set in Vercel
# URL: from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://bffuipcmtlfatvxkcpeq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Temporary compatibility during publishable-key migration:
VITE_SUPABASE_ANON_KEY=

# Stripe (publishable key only; never the secret key) — set in Vercel
VITE_STRIPE_PUBLISHABLE_KEY=
