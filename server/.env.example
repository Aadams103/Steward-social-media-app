# Steward backend runs on Railway; DB/auth/storage run on Supabase.
# Set in Railway Dashboard → Variables. Do NOT commit .env.

NODE_ENV=production
# PORT - Railway sets automatically

# Meta OAuth — callback is <base>/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_BASE=https://<railway-service-url>
META_GRAPH_API_VERSION=v25.0

# Supabase — backend only. Prefer the modern secret key; legacy service_role is
# accepted temporarily during migration. Never expose either key to the frontend.
SUPABASE_URL=https://bffuipcmtlfatvxkcpeq.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Temporary compatibility for the existing Railway service only. Rename it to
# SUPABASE_SECRET_KEY during deployment, then remove this variable.
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Cron / ingest (optional) - guard /api/cron/ingest
INGEST_SECRET=
CRON_SECRET=

# Frontend URL (CORS + Stripe checkout redirects)
FRONTEND_URL=https://steward-social-media-app.vercel.app

# Stripe (billing) - backend only; never expose the secret key to the frontend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO_EXPERT=
STRIPE_PRICE_AGENCY=

# Scheduled publishing worker (publish_jobs queue)
PUBLISH_WORKER_ENABLED=true
PUBLISH_WORKER_BATCH_SIZE=5
ANALYTICS_WORKER_ENABLED=true
AGENT_WORKER_ENABLED=true

# Steward AI Gateway (OpenAI — server-only, NEVER expose to frontend)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_DRAFT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_REQUEST_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
OPENAI_DAILY_ORG_BUDGET_CENTS=500
OPENAI_MONTHLY_ORG_BUDGET_CENTS=5000
