# Hostess (Steward) — Backend runs on Railway; DB/auth via Supabase (not hosted locally).
# Set in Railway Dashboard → Variables. Do NOT commit .env.

NODE_ENV=production
# PORT - Railway sets automatically

# Google OAuth (if used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_BASE=https://<railway-service-url>

# Meta OAuth (if used)
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_BASE=https://<railway-service-url>

# Supabase - backend only; set in Railway. Never expose service_role in frontend.
# Get service_role key from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://bffuipcmtlfatvxkcpeq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cron / ingest (optional) - guard /api/cron/ingest
INGEST_SECRET=
CRON_SECRET=

# Frontend URL (CORS + Stripe checkout redirects)
FRONTEND_URL=https://steward-social-media-app.vercel.app

# Stripe (billing) - backend only; never expose the secret key to the frontend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO_EXPERT=
STRIPE_PRICE_AGENCY=

# Scheduled publishing worker (publish_jobs queue)
PUBLISH_WORKER_ENABLED=false
PUBLISH_WORKER_BATCH_SIZE=5

# Steward AI Gateway (OpenAI — server-only, NEVER expose to frontend)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_DRAFT_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_REQUEST_TIMEOUT_MS=120000
OPENAI_DAILY_ORG_BUDGET_CENTS=500
OPENAI_MONTHLY_ORG_BUDGET_CENTS=5000
